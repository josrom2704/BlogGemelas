# Copia este archivo como ".env" para probar el panel de administración en local.
# En Vercel, estas mismas variables se configuran en Project Settings → Environment Variables.

# Usuario y contraseña de cada persona para entrar a /admin.
# El prefijo es la clave de la persona en src/config.ts, en mayúsculas.
FERNANDA_USER=fernanda
FERNANDA_PASS=cambia-esta-clave
JIMENA_USER=jimena
JIMENA_PASS=cambia-esta-clave
LOURDES_USER=lourdes
LOURDES_PASS=cambia-esta-clave
CAMILA_USER=camila
CAMILA_PASS=cambia-esta-clave
# Colaboradores: agrega una entrada en "colaboradores" de src/config.ts y luego, p. ej.:
# ANA_USER=ana
# ANA_PASS=cambia-esta-clave

# Frase secreta usada para firmar la sesión (cualquier texto largo y aleatorio)
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Token de GitHub con permiso de escritura (Contents) sobre el repo del blog
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=josrom2704
GITHUB_REPO=BlogGemelas
GITHUB_BRANCH=main

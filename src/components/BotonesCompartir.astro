---
interface Props {
  titulo: string;
  url: string;
}

const { titulo, url } = Astro.props;

const textoWhatsApp = encodeURIComponent(`${titulo} — ${url}`);
const linkWhatsApp = `https://wa.me/?text=${textoWhatsApp}`;
const linkFacebook = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---

<div class="compartir">
  <span class="compartir__etiqueta">Compartir:</span>
  <a class="boton boton-whatsapp" href={linkWhatsApp} target="_blank" rel="noopener noreferrer">
    WhatsApp
  </a>
  <a class="boton boton-facebook" href={linkFacebook} target="_blank" rel="noopener noreferrer">
    Facebook
  </a>
</div>

<style>
  .compartir {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .compartir__etiqueta {
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--color-texto-suave);
  }

  .compartir .boton {
    padding: 0.55rem 1.1rem;
    font-size: 0.85rem;
  }
</style>

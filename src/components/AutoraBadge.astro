---
import type { AutorId } from "../config";
import { nombreAutores, personasDe } from "../lib/autores";

interface Props {
  autores: AutorId[];
  tamano?: "sm" | "md";
}

const { autores, tamano = "md" } = Astro.props;

const personas = personasDe(autores);
const nombre = nombreAutores(autores);
---

<span class={`badge-autora badge-autora--${tamano}`}>
  <span class="badge-autora__grupo">
    {personas.map((persona) => (
      <span class="badge-autora__circulo" style={`background: ${persona.color};`}>
        {persona.foto && <img src={persona.foto} alt="" onerror="this.style.display='none';" />}
        {persona.inicial}
      </span>
    ))}
  </span>
  {nombre}
</span>

<style>
  .badge-autora__grupo {
    display: inline-flex;
  }

  .badge-autora__grupo .badge-autora__circulo + .badge-autora__circulo {
    margin-left: -0.55em;
    box-shadow: 0 0 0 2px white;
  }
</style>

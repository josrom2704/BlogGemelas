---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AutoraBadge from "../../components/AutoraBadge.astro";
import BotonesCompartir from "../../components/BotonesCompartir.astro";
import { getPublishedPosts, formatearFecha, tiempoDeLectura } from "../../lib/posts";
import { site } from "../../config";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      anterior: posts[index + 1] ?? null,
      siguiente: posts[index - 1] ?? null,
    },
  }));
}

const { post, anterior, siguiente } = Astro.props;
const { Content } = await render(post);
const { title, description, cover, coverAlt, category, date, author } = post.data;
const minutos = tiempoDeLectura(post.body ?? "");
const urlActual = new URL(Astro.url.pathname, site.url).toString();

const colorAcento = {
  fernanda: "#8B2439",
  jimena: "#1B2A4A",
  ambas: undefined,
} as const;
---

<BaseLayout title={title} description={description} image={cover} articulo>
  <article class="post" style={colorAcento[author] ? `--acento: ${colorAcento[author]}` : undefined}>
    <header class="post__encabezado">
      <div class="contenedor post__encabezado-interior">
        <p class="post__categoria">
          <a href={`/blog/?categoria=${encodeURIComponent(category)}`}>{category}</a>
        </p>
        <h1 class="post__titulo">{title}</h1>
        <div class="post__meta">
          <AutoraBadge autor={author} />
          <span class="texto-suave">{formatearFecha(date)} · {minutos} min de lectura</span>
        </div>
      </div>
    </header>

    <div class="post__portada-wrapper contenedor">
      <img class="post__portada" src={cover} alt={coverAlt ?? title} />
    </div>

    <div class="contenedor post__cuerpo-wrapper">
      <div class="post__cuerpo">
        <Content />
      </div>

      <BotonesCompartir titulo={title} url={urlActual} />

      <nav class="post__navegacion">
        {anterior ? (
          <a class="post__nav-enlace post__nav-enlace--anterior" href={`/blog/${anterior.id}/`}>
            <span class="texto-suave">← Anterior</span>
            <span class="post__nav-titulo">{anterior.data.title}</span>
          </a>
        ) : <span></span>}
        {siguiente ? (
          <a class="post__nav-enlace post__nav-enlace--siguiente" href={`/blog/${siguiente.id}/`}>
            <span class="texto-suave">Siguiente →</span>
            <span class="post__nav-titulo">{siguiente.data.title}</span>
          </a>
        ) : <span></span>}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .post__encabezado {
    background: var(--color-rosa);
    padding: 2.5rem 0 2rem;
  }

  .post__categoria {
    margin: 0 0 0.6rem;
  }

  .post__categoria a {
    text-decoration: none;
    font-weight: 800;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--acento, var(--color-fernanda));
  }

  .post__titulo {
    max-width: 820px;
  }

  .post__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  .post__portada-wrapper {
    margin-top: -1.75rem;
  }

  .post__portada {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: var(--radio-tarjeta);
    box-shadow: var(--sombra-suave);
  }

  .post__cuerpo-wrapper {
    max-width: 760px;
  }

  .post__cuerpo {
    margin-top: 2.5rem;
    font-size: 1.08rem;
  }

  .post__cuerpo :global(h2) {
    margin-top: 1.8em;
  }

  .post__cuerpo :global(a) {
    color: var(--acento, var(--color-fernanda));
  }

  .post__cuerpo :global(blockquote) {
    border-left: 4px solid var(--acento, var(--color-rosa));
    margin: 1.5em 0;
    padding: 0.3em 1.2em;
    color: var(--color-texto-suave);
    font-style: italic;
  }

  .post__navegacion {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 3rem 0 2rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--color-rosa);
  }

  .post__nav-enlace {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--color-texto);
    padding: 0.75rem;
    border-radius: 14px;
    transition: background 0.15s ease;
  }

  .post__nav-enlace:hover {
    background: var(--color-rosa);
  }

  .post__nav-enlace--siguiente {
    text-align: right;
    align-items: flex-end;
  }

  .post__nav-titulo {
    font-weight: 800;
  }

  @media (max-width: 600px) {
    .post__navegacion {
      grid-template-columns: 1fr;
    }

    .post__nav-enlace--siguiente {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>

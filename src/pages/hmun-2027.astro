---
import BaseLayout from "../layouts/BaseLayout.astro";
import CuentaRegresiva from "../components/CuentaRegresiva.astro";
import PostCard from "../components/PostCard.astro";
import { hmun, actividadesRecaudacion } from "../config";
import { getPublishedPosts, formatearFecha } from "../lib/posts";

const posts = await getPublishedPosts();
const postsHmun = posts.filter((p) => p.data.category === "HMUN 2027");
---

<BaseLayout
  title={hmun.siglas}
  description={`Todo sobre nuestro camino hacia el ${hmun.nombreEvento}: qué es, quiénes vamos y cómo estamos recaudando fondos.`}
>
  <section class="hmun-hero">
    <div class="contenedor centro">
      <p class="hmun-hero__kicker">Nuestro gran proyecto</p>
      <h1 class="titulo-brocha">Camino a {hmun.siglas}</h1>
      <p class="hmun-hero__fecha">{hmun.fechaTextoCorta} · {hmun.ciudad}</p>
      <div class="hmun-hero__cuenta">
        <CuentaRegresiva />
      </div>
    </div>
  </section>

  <section class="seccion contenedor">
    <div class="grid-2">
      <div>
        <h2 class="titulo-brocha">¿Qué es HMUN?</h2>
        <p>{hmun.descripcion}</p>
        <p>
          Este año representamos a <strong>{hmun.paisRepresentado}</strong> junto a delegaciones de todo el mundo, defendiendo posturas, negociando resoluciones y practicando diplomacia real.
        </p>
      </div>
      <div class="tarjeta hmun-delegacion">
        <h3>La delegación</h3>
        <ul class="hmun-delegacion__lista">
          {hmun.delegacion.map((persona) => (
            <li>
              <span class="hmun-delegacion__circulo">{persona.nombre.charAt(0)}</span>
              {persona.nombre}
            </li>
          ))}
        </ul>
        <p class="texto-suave hmun-delegacion__nota">
          Representando a {hmun.paisRepresentado} en {hmun.nombreEvento}.
        </p>
      </div>
    </div>
  </section>

  <section class="seccion contenedor">
    <h2 class="titulo-brocha">Actividades de recaudación</h2>
    <div class="grid-posts hmun-actividades">
      {actividadesRecaudacion.map((act) => (
        <div class="tarjeta hmun-actividad">
          <span class="hmun-actividad__icono">{act.icono}</span>
          <h3>{act.titulo}</h3>
          <p class="texto-suave">{act.descripcion}</p>
        </div>
      ))}
    </div>
    <div class="hmun-actividades__cta">
      <a class="boton boton-primario" href="/como-ayudar/">Quiero ayudar</a>
    </div>
  </section>

  <section class="seccion contenedor">
    <h2 class="titulo-brocha">Timeline del proyecto</h2>
    {postsHmun.length === 0 ? (
      <p class="texto-suave">Pronto iremos contando cada paso del camino aquí.</p>
    ) : (
      <ol class="hmun-timeline">
        {postsHmun.map((post) => (
          <li class="hmun-timeline__item">
            <span class="hmun-timeline__fecha texto-suave">{formatearFecha(post.data.date)}</span>
            <a class="hmun-timeline__titulo" href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p class="texto-suave hmun-timeline__desc">{post.data.description}</p>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  .hmun-hero {
    background: linear-gradient(120deg, var(--color-jimena) 0%, #2b3d63 100%);
    color: white;
    padding: 3.5rem 0 3rem;
  }

  .hmun-hero h1 {
    color: white;
  }

  .hmun-hero__kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
    font-size: 0.8rem;
    color: var(--color-rosa);
    margin-bottom: 0.4rem;
  }

  .hmun-hero__fecha {
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
  }

  .hmun-hero__cuenta {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .hmun-delegacion {
    padding: 1.75rem;
  }

  .hmun-delegacion__lista {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: grid;
    gap: 0.75rem;
  }

  .hmun-delegacion__lista li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
  }

  .hmun-delegacion__circulo {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--gradiente-ambas);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-manuscrita);
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .hmun-delegacion__nota {
    margin: 0;
    font-size: 0.85rem;
  }

  .hmun-actividad {
    padding: 1.75rem;
    gap: 0.5rem;
  }

  .hmun-actividad__icono {
    font-size: 2rem;
  }

  .hmun-actividades__cta {
    text-align: center;
    margin-top: 2rem;
  }

  .hmun-timeline {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1.25rem;
    border-left: 3px solid var(--color-rosa);
  }

  .hmun-timeline__item {
    padding-left: 1.5rem;
    position: relative;
  }

  .hmun-timeline__item::before {
    content: "";
    position: absolute;
    left: -0.45rem;
    top: 0.3rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-fernanda);
  }

  .hmun-timeline__fecha {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.2rem;
  }

  .hmun-timeline__titulo {
    font-family: var(--font-manuscrita);
    font-size: 1.4rem;
    text-decoration: none;
    color: var(--color-texto);
  }

  .hmun-timeline__titulo:hover {
    text-decoration: underline;
  }

  .hmun-timeline__desc {
    margin: 0.3rem 0 0;
  }
</style>

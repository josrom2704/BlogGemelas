---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactosAyuda, actividadesRecaudacion, hmun } from "../config";
---

<BaseLayout
  title="Cómo ayudar"
  description={`Apoya a la delegación de ${hmun.paisRepresentado} rumbo al ${hmun.nombreEvento}: rifa, Garage Sale y donaciones.`}
>
  <section class="seccion contenedor">
    <header class="centro ayuda__intro">
      <h1 class="titulo-brocha">Cómo ayudar</h1>
      <p class="texto-suave">
        Llegar a {hmun.ciudad} es un esfuerzo de todo un equipo. Cada rifa, cada donación y cada compra en el Garage Sale nos acerca un poco más. Gracias por ser parte de esto.
      </p>
    </header>

    <div class="grid-posts ayuda__actividades">
      {actividadesRecaudacion.map((act) => (
        <div class="tarjeta ayuda__actividad">
          <span class="ayuda__icono">{act.icono}</span>
          <h3>{act.titulo}</h3>
          <p class="texto-suave">{act.descripcion}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="ayuda-contacto">
    <div class="contenedor centro">
      <h2 class="titulo-brocha">Escríbenos por WhatsApp</h2>
      <p class="texto-suave ayuda-contacto__texto">
        Cuéntanos si quieres donar, comprar un boleto de rifa o llevar algo al Garage Sale. Con gusto coordinamos contigo.
      </p>
      <div class="ayuda-contacto__grid">
        {contactosAyuda.map((c) => (
          <a class="tarjeta ayuda-contacto__tarjeta" href={c.link} target="_blank" rel="noopener noreferrer">
            <span class="ayuda-contacto__nombre">{c.nombre}</span>
            <span class="texto-suave ayuda-contacto__rol">{c.rol}</span>
            <span class="boton boton-whatsapp ayuda-contacto__boton">Escribir por WhatsApp</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ayuda__intro {
    max-width: 620px;
    margin: 0 auto 2.5rem;
  }

  .ayuda__actividad {
    padding: 1.75rem;
    gap: 0.5rem;
  }

  .ayuda__icono {
    font-size: 2rem;
  }

  .ayuda-contacto {
    background: var(--color-azul-claro);
    padding: 3.5rem 0;
  }

  .ayuda-contacto__texto {
    max-width: 560px;
    margin: 0.75rem auto 2rem;
  }

  .ayuda-contacto__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 780px;
    margin: 0 auto;
  }

  @media (min-width: 700px) {
    .ayuda-contacto__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ayuda-contacto__tarjeta {
    padding: 1.75rem 1.25rem;
    align-items: center;
    text-decoration: none;
    color: var(--color-texto);
    gap: 0.4rem;
    transition: transform 0.15s ease;
  }

  .ayuda-contacto__tarjeta:hover {
    transform: translateY(-4px);
  }

  .ayuda-contacto__nombre {
    font-family: var(--font-manuscrita);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .ayuda-contacto__rol {
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .ayuda-contacto__boton {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    padding: 0.55rem 1.1rem;
  }
</style>

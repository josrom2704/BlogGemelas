---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import CuentaRegresiva from "../components/CuentaRegresiva.astro";
import Corazon from "../components/Corazon.astro";
import IconoInstagram from "../components/IconoInstagram.astro";
import { getPublishedPosts } from "../lib/posts";
import { site, hmun, idsIntegrantes, personas, redes } from "../config";

const posts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout title={site.nombre}>
  <section class="hero">
    <div class="contenedor hero__interior">
      <img class="hero__emblema" src="/images/logo-emblema.png" alt="" width="256" height="256" />
      <p class="hero__kicker">Un diario compartido desde El Salvador</p>
      <h1 class="hero__titulo">{site.nombre}</h1>
      <p class="hero__lema">
        {site.lema} <Corazon color="#8B2439" class="hero__corazon" />
      </p>
      <p class="hero__descripcion texto-suave">{site.descripcion}</p>
      <div class="hero__acciones">
        <a class="boton boton-primario" href="/blog/">Leer el blog</a>
        <a class="boton boton-secundario" href="/hmun-2027/">Conocer HMUN 2027</a>
      </div>
    </div>
  </section>

  <section class="seccion contenedor">
    <h2 class="titulo-brocha centro-si-movil">Somos nosotras</h2>
    <p class="texto-suave presentacion__intro">
      Somos la delegación de El Salvador en {hmun.siglas}: cuatro compañeras con un mismo sueño.
    </p>
    <div class="presentacion">
      {idsIntegrantes.map((id) => {
        const persona = personas[id];
        return (
          <article class="tarjeta presentacion__tarjeta" style={`--acento: ${persona.color}`}>
            <div class="presentacion__avatar" style={`background:${persona.color}`}>
              {persona.foto && (
                <img
                  src={persona.foto}
                  alt={persona.nombre}
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
              )}
              <span class="presentacion__inicial" style={persona.foto ? "display:none;" : "display:flex;"}>{persona.inicial}</span>
            </div>
            <h3>{persona.nombre}</h3>
            {persona.frase && <p class="texto-suave presentacion__frase">"{persona.frase}"</p>}
            <a class="presentacion__enlace" href={`/sobre-nosotras/#${id}`}>Conocerla mejor →</a>
          </article>
        );
      })}
    </div>
  </section>

  <section class="hmun-banner">
    <div class="contenedor hmun-banner__interior">
      <div>
        <p class="hmun-banner__kicker">Nuestro gran proyecto</p>
        <h2>Vamos rumbo a {hmun.siglas}</h2>
        <p class="hmun-banner__texto">
          Fuimos aceptadas como Delegación de El Salvador en el {hmun.nombreEvento}, del {hmun.fechaTextoCorta} en {hmun.ciudad}. Estamos recaudando fondos para llegar todas juntas.
        </p>
        <div class="hero__acciones">
          <a class="boton boton-primario" href="/hmun-2027/">Ver el proyecto</a>
          <a class="boton boton-secundario" href="/como-ayudar/">Cómo ayudar</a>
        </div>
      </div>
      <div>
        <p class="hmun-banner__cuenta-titulo">Faltan</p>
        <CuentaRegresiva />
      </div>
    </div>
  </section>

  <section class="seccion contenedor">
    <div class="ultimos-posts__encabezado">
      <h2 class="titulo-brocha">Últimas entradas</h2>
      <a href="/blog/" class="ultimos-posts__ver-todo">Ver todo el blog →</a>
    </div>

    {posts.length === 0 ? (
      <p class="texto-suave">Pronto empezaremos a publicar. ¡Vuelve pronto!</p>
    ) : (
      <div class="grid-posts">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    )}
  </section>

  {redes.instagram && (
    <section class="contenedor">
      <a class="instagram-banda" href={redes.instagram} target="_blank" rel="noopener">
        <span class="instagram-banda__icono"><IconoInstagram /></span>
        <span class="instagram-banda__texto">
          <span class="instagram-banda__titulo">Síguenos en Instagram</span>
          <span class="instagram-banda__usuario">@{site.usuario}</span>
        </span>
        <span class="instagram-banda__accion">Ver perfil →</span>
      </a>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-rosa) 0%, var(--color-crema) 100%);
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .hero__interior {
    max-width: 720px;
  }

  .hero__emblema {
    width: 9rem;
    height: 9rem;
    margin: 0 auto 1rem;
  }

  @media (max-width: 600px) {
    .hero__emblema {
      width: 7rem;
      height: 7rem;
    }
  }

  .hero__kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
    font-size: 0.8rem;
    color: var(--color-fernanda);
    margin-bottom: 0.5rem;
  }

  .hero__titulo {
    margin-bottom: 0.3rem;
  }

  .hero__lema {
    font-family: var(--font-manuscrita);
    font-size: 1.8rem;
    color: var(--color-jimena);
    margin-bottom: 1rem;
  }

  .hero__corazon {
    width: 1.3rem;
    height: 1.3rem;
  }

  .hero__descripcion {
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero__acciones {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .presentacion__intro {
    max-width: 640px;
    margin: -0.5rem 0 1.75rem;
  }

  .presentacion {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }

  .presentacion__tarjeta {
    padding: 2rem 1.25rem;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
    border-top: 5px solid var(--acento);
  }

  .presentacion__avatar {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    margin-bottom: 0.5rem;
  }

  .presentacion__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .presentacion__inicial {
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    color: white;
    font-family: var(--font-manuscrita);
    font-size: 2.4rem;
    font-weight: 700;
  }

  .presentacion__frase {
    font-style: italic;
    max-width: 320px;
  }

  .presentacion__enlace {
    text-decoration: none;
    font-weight: 800;
    color: var(--acento);
    font-size: 0.9rem;
  }

  .hmun-banner {
    background: var(--color-jimena);
    background: linear-gradient(120deg, var(--color-jimena) 0%, #2b3d63 100%);
    color: white;
    padding: 3.5rem 0;
  }

  .hmun-banner h2 {
    color: white;
  }

  .hmun-banner__interior {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 780px) {
    .hmun-banner__interior {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .hmun-banner__kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
    font-size: 0.8rem;
    color: var(--color-rosa);
    margin-bottom: 0.4rem;
  }

  .hmun-banner__texto {
    color: rgba(255, 255, 255, 0.85);
    max-width: 520px;
  }

  .hmun-banner__cuenta-titulo {
    font-family: var(--font-manuscrita);
    font-size: 1.4rem;
    margin-bottom: 0.6rem;
    color: white;
  }

  .instagram-banda {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
    padding: 1.4rem 1.75rem;
    margin-bottom: 1.5rem;
    border-radius: var(--radio-tarjeta);
    background: var(--gradiente-ambas);
    color: white;
    text-decoration: none;
    box-shadow: var(--sombra-suave);
    transition: transform 0.2s ease;
  }

  .instagram-banda:hover {
    transform: translateY(-2px);
  }

  .instagram-banda__icono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
  }

  .instagram-banda__icono :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .instagram-banda__texto {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 12rem;
  }

  .instagram-banda__titulo {
    font-family: var(--font-manuscrita);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .instagram-banda__usuario {
    opacity: 0.85;
    font-weight: 700;
    word-break: break-all;
  }

  .instagram-banda__accion {
    font-weight: 800;
    background: white;
    color: var(--color-fernanda);
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
  }

  .ultimos-posts__encabezado {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .ultimos-posts__ver-todo {
    text-decoration: none;
    font-weight: 800;
    color: var(--color-fernanda);
    font-size: 0.9rem;
  }
</style>

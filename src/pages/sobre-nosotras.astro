---
import BaseLayout from "../layouts/BaseLayout.astro";
import Corazon from "../components/Corazon.astro";
import { colaboradores, idsIntegrantes, loQueCompartimos, personas, site, type AutorId } from "../config";

const idsColaboradores = Object.keys(colaboradores) as AutorId[];
---

<BaseLayout title="Sobre nosotras" description={`Conoce a la delegación detrás de ${site.nombre}: quiénes somos, qué nos gusta y qué soñamos.`}>
  <section class="seccion contenedor">
    <header class="centro sobre__intro">
      <h1 class="titulo-brocha">Sobre nosotras</h1>
      <p class="texto-suave">
        Somos cuatro compañeras que representan a El Salvador en HMUN 2027. Cada una escribe con su propia voz, y esta página es para que nos conozcas un poco mejor.
      </p>
    </header>

    <div class="sobre__grid">
      {idsIntegrantes.map((id) => {
        const persona = personas[id];
        return (
          <article id={id} class="tarjeta sobre__tarjeta" style={`--acento: ${persona.color}`}>
            <div class="sobre__encabezado">
              <div class="sobre__avatar" style={`background:${persona.color}`}>
                {persona.foto && (
                  <img
                    src={persona.foto}
                    alt={persona.nombre}
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                )}
                <span class="sobre__inicial" style={persona.foto ? "display:none;" : "display:flex;"}>{persona.inicial}</span>
              </div>
              <div>
                <h2>{persona.nombre}</h2>
                {persona.frase && <p class="sobre__frase texto-suave">"{persona.frase}"</p>}
              </div>
            </div>

            {persona.presentacion && persona.presentacion.length > 0 && (
              <div class="sobre__presentacion">
                <p>{persona.presentacion[0]}</p>
                {persona.presentacion.length > 1 && (
                  <details class="sobre__mas">
                    <summary>Seguir leyendo</summary>
                    {persona.presentacion.slice(1).map((parrafo) => <p>{parrafo}</p>)}
                  </details>
                )}
              </div>
            )}

            {persona.gustos && persona.gustos.length > 0 && (
              <>
                <h3 class="sobre__subtitulo">Le gusta</h3>
                <ul class="sobre__lista">
                  {persona.gustos.map((g) => <li>{g}</li>)}
                </ul>
              </>
            )}

            {persona.suenos && persona.suenos.length > 0 && (
              <>
                <h3 class="sobre__subtitulo">Sueña con</h3>
                <ul class="sobre__lista">
                  {persona.suenos.map((s) => <li>{s}</li>)}
                </ul>
              </>
            )}

            <a class="sobre__ver-posts" href={`/blog/?autor=${id}`}>Ver sus posts →</a>
          </article>
        );
      })}
    </div>
  </section>

  {idsColaboradores.length > 0 && (
    <section class="seccion contenedor colaboradores">
      <h2 class="titulo-brocha centro">Quienes nos acompañan</h2>
      <p class="texto-suave centro">Personas que colaboran con el proyecto y también escriben en el blog.</p>
      <ul class="colaboradores__lista">
        {idsColaboradores.map((id) => {
          const persona = personas[id];
          return (
            <li id={id} class="tarjeta colaboradores__item">
              <span class="badge-autora__circulo colaboradores__circulo" style={`background:${persona.color}`}>{persona.inicial}</span>
              <div>
                <strong>{persona.nombre}</strong>
                <span class="texto-suave">{persona.rol}</span>
              </div>
              <a href={`/blog/?autor=${id}`}>Ver sus posts →</a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="compartimos">
    <div class="contenedor centro">
      <h2 class="titulo-brocha">Lo que compartimos <Corazon color="#8B2439" class="compartimos__corazon" /></h2>
      <ul class="compartimos__lista">
        {loQueCompartimos.map((frase) => <li>{frase}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .sobre__intro {
    max-width: 640px;
    margin: 0 auto 2.5rem;
  }

  .sobre__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media (min-width: 760px) {
    .sobre__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .sobre__tarjeta {
    padding: 2rem;
    border-top: 5px solid var(--acento);
    gap: 0;
  }

  .sobre__encabezado {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .sobre__avatar {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  .sobre__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sobre__inicial {
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    color: white;
    font-family: var(--font-manuscrita);
    font-size: 1.9rem;
    font-weight: 700;
  }

  .sobre__tarjeta h2 {
    margin-bottom: 0.2rem;
  }

  .sobre__frase {
    font-style: italic;
    margin: 0;
    font-size: 0.92rem;
  }

  .sobre__presentacion p {
    margin: 0 0 0.8rem;
    line-height: 1.65;
  }

  .sobre__mas summary {
    cursor: pointer;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--acento);
    list-style: none;
    margin-bottom: 0.8rem;
  }

  .sobre__mas summary::-webkit-details-marker {
    display: none;
  }

  .sobre__mas summary::after {
    content: " ↓";
  }

  .sobre__mas[open] summary::after {
    content: " ↑";
  }

  .sobre__mas[open] summary {
    font-size: 0;
    margin: 0;
  }

  .sobre__mas[open] summary::after {
    font-size: 0.9rem;
    content: "Mostrar menos ↑";
  }

  .sobre__subtitulo {
    font-family: var(--font-texto);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--acento);
    font-weight: 800;
    margin: 1.2rem 0 0.5rem;
  }

  .sobre__lista {
    margin: 0;
    padding-left: 1.2rem;
  }

  .sobre__lista li {
    margin-bottom: 0.3rem;
  }

  .sobre__ver-posts {
    display: inline-block;
    margin-top: 1.5rem;
    text-decoration: none;
    font-weight: 800;
    color: var(--acento);
    font-size: 0.9rem;
  }

  .colaboradores__lista {
    list-style: none;
    padding: 0;
    margin: 1.5rem auto 0;
    max-width: 720px;
    display: grid;
    gap: 0.9rem;
  }

  .colaboradores__item {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }

  .colaboradores__item div {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .colaboradores__item a {
    font-weight: 800;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .colaboradores__circulo {
    width: 2.6rem;
    height: 2.6rem;
  }

  .compartimos {
    background: var(--color-azul-claro);
    padding: 3.5rem 0;
    margin-top: 1rem;
  }

  .compartimos__corazon {
    width: 1.4rem;
    height: 1.4rem;
  }

  .compartimos__lista {
    list-style: none;
    padding: 0;
    max-width: 640px;
    margin: 1.5rem auto 0;
    display: grid;
    gap: 0.9rem;
  }

  .compartimos__lista li {
    background: white;
    border-radius: 16px;
    padding: 1rem 1.3rem;
    box-shadow: var(--sombra-suave);
    font-weight: 700;
  }
</style>
